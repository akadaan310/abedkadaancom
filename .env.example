# Model providers. All optional, tried in the order listed in lab/models/providers.ts.
# With none of them set, the laboratory runs on its deterministic offline proposer,
# which is labelled `local-heuristic` everywhere and never claims to be a model.
GROQ_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Not yet wired to any capability. Present so the absence is visible rather than implied.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ELEVENLABS_API_KEY=

# Live demonstrations are public and call paid APIs. Guards are conservative by default.
DEMO_ENABLED=1
DEMO_DAILY_CALL_CAP=400

# Set to 1 where the filesystem is read-only; the ledger then reports an explicit
# capability absence instead of failing opaquely.
# LAB_LEDGER_READONLY=1
